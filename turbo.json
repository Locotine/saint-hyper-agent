{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "AZURE_TRUSTED_SIGNING_SUBJECT_DN",
    "PORT",
    "VITE_WS_URL",
    "VITE_DEV_SERVER_URL",
    "ELECTRON_RENDERER_PORT",
    "SAINT_HOME",
    "SAINT_DESKTOP_WS_URL",
    "SAINT_BROWSER_HOST_PIPE_PATH",
    "SAINT_BROWSER_USE_PIPE_PATH",
    "SAINT_BROWSER_PERF",
    "SAINT_PROVIDER_RUNTIME_IDLE_STOP_MS",
    "SAINT_GROK_ACP_DEBUG",
    "SAINT_WEB_SOURCEMAP",
    "SAINT_DEV_REACT_COMPILER",
    "SAINT_SERVER_SOURCEMAP",
    "SAINT_DESKTOP_SOURCEMAP",
    "SAINT_MODE",
    "SAINT_PORT",
    "SAINT_NO_BROWSER",
    "SAINT_AUTH_TOKEN",
    "SAINT_PUBLIC_URL",
    "SAINT_ALLOW_INSECURE_REMOTE",
    "SAINT_LOG_WS_EVENTS",
    "SAINT_HOST",
    "SAINT_AUTO_BOOTSTRAP_PROJECT_FROM_CWD"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "dist-electron/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": [],
      "cache": false
    },
    "typecheck:native": {
      "dependsOn": ["^typecheck:native"],
      "outputs": [],
      "cache": false
    },
    "typecheck:legacy": {
      "dependsOn": ["^typecheck:legacy"],
      "outputs": [],
      "cache": false
    },
    "test": {
      "cache": false,
      "outputs": []
    }
  }
}
